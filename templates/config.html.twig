{#
 # RefactoryTools — configuração.
 #
 # Cada opção traz a consequência escrita abaixo dela. São chaves que mudam
 # quem enxerga a agenda de quem, e o efeito de "equipe recursiva" não é
 # óbvio pelo rótulo.
 #}

<div class="card">
    <form method="post" action="">
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">

        <div class="card-header">
            <h3 class="card-title">
                {{ section == 'reservations' ? __('Reservation configuration', 'refactorytools') : __('Plugin configuration', 'refactorytools') }}
            </h3>
        </div>

        <div class="card-body">

            {% if section != 'reservations' %}
            <h4 class="mb-2">{{ __('Team', 'refactorytools') }}</h4>

            <div class="mb-3">
                <label class="form-check form-switch">
                    <input type="hidden" name="team_recursive" value="0">
                    <input type="checkbox" class="form-check-input" name="team_recursive" value="1"
                           {{ settings.team_recursive == '1' ? 'checked' : '' }}>
                    <span class="form-check-label">
                        {{ __('Include the whole hierarchy below the supervisor', 'refactorytools') }}
                    </span>
                </label>
                <div class="form-hint">
                    {{ __('When off, "my team" means direct reports only: the users whose Supervisor field points to me. When on, it also includes their own reports, and so on. In a tall org chart this lets a director see almost the whole company schedule.', 'refactorytools') }}
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">{{ __('Detail level for the team', 'refactorytools') }}</label>
                <select name="team_level" class="form-select">
                    {% for value, label in level_labels %}
                        <option value="{{ value }}" {{ settings.team_level == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>

            <hr>

            <h4 class="mb-2">{{ __('Groups', 'refactorytools') }}</h4>

            <div class="mb-3">
                <label class="form-label">{{ __('Detail level for group colleagues', 'refactorytools') }}</label>
                <select name="group_level" class="form-select">
                    {% for value, label in level_labels %}
                        <option value="{{ value }}" {{ settings.group_level == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>

            <hr>

            <h4 class="mb-2">{{ __('Shares', 'refactorytools') }}</h4>

            <div class="mb-3">
                <label class="form-label">{{ __('Suggested level when sharing', 'refactorytools') }}</label>
                <select name="default_share_level" class="form-select">
                    {% for value, label in level_labels %}
                        <option value="{{ value }}" {{ settings.default_share_level == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
                <div class="form-hint">
                    {{ __('Only the value preselected in the form. Whoever shares can change it.', 'refactorytools') }}
                </div>
            </div>

            <div class="mb-3">
                <label class="form-check form-switch">
                    <input type="hidden" name="allow_self_request" value="0">
                    <input type="checkbox" class="form-check-input" name="allow_self_request" value="1"
                           {{ settings.allow_self_request == '1' ? 'checked' : '' }}>
                    <span class="form-check-label">
                        {{ __('Allow users to request access to a schedule', 'refactorytools') }}
                    </span>
                </label>
                <div class="form-hint">
                    {{ __('A request reveals nothing on its own: no event shows up before the owner accepts it.', 'refactorytools') }}
                </div>
            </div>

            <hr>

            <h4 class="mb-2">{{ __('Enabled commitment types', 'refactorytools') }}</h4>

            <div class="mb-3">
                <div class="form-hint mb-2">
                    {{ __('A disabled type disappears from the sidebar filter, the legend and "+ New commitment" — it never disappears from an existing commitment, only from being filtered or created new.', 'refactorytools') }}
                </div>
                <div class="refactorytools-color-grid">
                    {% for type in types %}
                        <label class="refactorytools-color-row">
                            <input type="checkbox" class="form-check-input" name="enabled_types[]"
                                   value="{{ type.itemtype }}" {{ type.enabled ? 'checked' : '' }}>
                            <span class="refactorytools-color-name">{{ type.label }}</span>
                        </label>
                    {% endfor %}
                </div>
                <input type="hidden" name="enabled_types_defined" value="1">
            </div>

            <hr>

            <h4 class="mb-2">{{ __('Event type colours', 'refactorytools') }}</h4>

            <div class="mb-3">
                <div class="form-hint mb-2">
                    {{ __('The colour identifies the type of appointment on the calendar, in the list and on the Kanban cards. Leave a type untouched to keep the plugin default.', 'refactorytools') }}
                </div>
                <div class="refactorytools-color-grid">
                    {% for type in types %}
                        <label class="refactorytools-color-row">
                            <input type="color" name="type_color[{{ type.itemtype }}]"
                                   value="{{ type.color }}"
                                   data-refactorytools-default="{{ type.default }}">
                            <span class="refactorytools-color-name">{{ type.label }}</span>
                            <button type="button" class="btn btn-sm btn-ghost-secondary refactorytools-color-reset"
                                    title="{{ __('Back to default', 'refactorytools') }}">
                                <i class="ti ti-rotate"></i>
                            </button>
                        </label>
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% if section != 'reservations' %}
            <hr>

            <h4 class="mb-2">{{ __('Screen', 'refactorytools') }}</h4>

            <div class="mb-3">
                <label class="form-check form-switch">
                    <input type="hidden" name="override_native_planning" value="0">
                    <input type="checkbox" class="form-check-input" name="override_native_planning" value="1"
                           {{ settings.override_native_planning == '1' ? 'checked' : '' }}>
                    <span class="form-check-label">
                        {{ __('Replace the native Planning', 'refactorytools') }}
                    </span>
                </label>
                <div class="form-hint">
                    {{ __('When on, the "Planning" entry under Assistance opens this screen, and anyone reaching the old URL is redirected. The menu label stays "Planning": "RefactoryTools" is the plugin name, not the entry name. When off, the native planning is restored and RefactoryTools appears as a separate entry, which is useful to compare both screens.', 'refactorytools') }}
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">{{ __('Default mode', 'refactorytools') }}</label>
                <select name="default_mode" class="form-select">
                    {% for value, label in mode_labels %}
                        <option value="{{ value }}" {{ settings.default_mode == value ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
                <div class="form-hint">
                    {{ __('How the screen opens. Users can switch between Calendar, List and Kanban at any time.', 'refactorytools') }}
                </div>
            </div>

            <div class="mb-3">
                <label class="form-check form-switch">
                    <input type="hidden" name="auto_load_team" value="0">
                    <input type="checkbox" class="form-check-input" name="auto_load_team" value="1"
                           {{ settings.auto_load_team == '1' ? 'checked' : '' }}>
                    <span class="form-check-label">
                        {{ __('Open the schedule with the team already selected', 'refactorytools') }}
                    </span>
                </label>
            </div>

            <div class="mb-3">
                <label class="form-check form-switch">
                    <input type="hidden" name="technician_panel_enabled" value="0">
                    <input type="checkbox" class="form-check-input" name="technician_panel_enabled" value="1"
                           {{ settings.technician_panel_enabled == '1' ? 'checked' : '' }}>
                    <span class="form-check-label">
                        {{ __('Show the "My tickets as a technician" panel', 'refactorytools') }}
                    </span>
                </label>
                <div class="form-hint">
                    {{ __('Turns off both the hours shown and the "See all my tickets" link, in the schedule sidebar.', 'refactorytools') }}
                </div>
            </div>
            {% endif %}

            {% if reservation_types is not empty %}
                <hr>

                <h4 class="mb-2">{{ __('Reservations', 'refactorytools') }}</h4>

                <div class="mb-3">
                    <label class="form-check form-switch">
                        <input type="hidden" name="override_native_reservation" value="0">
                        <input type="checkbox" class="form-check-input" name="override_native_reservation" value="1"
                               {{ settings.override_native_reservation == '1' ? 'checked' : '' }}>
                        <span class="form-check-label">
                            {{ __('Replace the native Reservations', 'refactorytools') }}
                        </span>
                    </label>
                    <div class="form-hint">
                        {{ __('When on, the "Reservations" entry under Tools opens this screen, and anyone reaching the old URL is redirected. Reserving a specific item still goes to the native form, which checks for conflicts.', 'refactorytools') }}
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-check form-switch">
                        <input type="hidden" name="reservation_allow_edit_all" value="0">
                        <input type="checkbox" class="form-check-input" name="reservation_allow_edit_all" value="1"
                               {{ settings.reservation_allow_edit_all == '1' ? 'checked' : '' }}>
                        <span class="form-check-label">
                            {{ __('Anyone can edit or cancel any reservation', 'refactorytools') }}
                        </span>
                    </label>
                    <div class="form-hint">
                        {{ __('Off (default): only the person who made the reservation can edit or cancel it. On: anyone with access to the Reservations screen can edit or cancel anyone\'s reservation.', 'refactorytools') }}
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-check form-switch">
                        <input type="hidden" name="reservation_history_visible_to_all" value="0">
                        <input type="checkbox" class="form-check-input" name="reservation_history_visible_to_all" value="1"
                               {{ settings.reservation_history_visible_to_all == '1' ? 'checked' : '' }}>
                        <span class="form-check-label">
                            {{ __('Anyone can see the reservation history', 'refactorytools') }}
                        </span>
                    </label>
                    <div class="form-hint">
                        {{ __('Anyone with "See all schedules" can already see it. This turns it on for everyone else with access to the Reservations screen too.', 'refactorytools') }}
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">{{ __('Who can see the reservation report', 'refactorytools') }}</label>
                    <div class="refactorytools-picker">
                        {{ 'User'|itemtype_dropdown({
                            name: 'reservation_report_user_ids',
                            {# `User::dropdown()` com `multiple: true` lê a
                               pré-seleção de `value` (singular!), não de
                               `values` — ele SOBRESCREVE `values` internamente
                               com `value ?? []` antes de montar o dropdown.
                               Passar em `values` aqui (como o nome sugeriria)
                               faz esse array virar a string vazia default de
                               `value`, e o `array_combine()` do core quebra a
                               tela inteira. #}
                            value: reservation_report_user_ids,
                            multiple: true,
                            entity: session('glpiactive_entity'),
                            entity_sons: session('glpiactive_entity_recursive'),
                            width: '100%'
                        }) }}
                    </div>
                    <input type="hidden" name="reservation_report_user_ids_defined" value="1">
                    <div class="form-hint">
                        {{ __('Anyone with "See all schedules" can already see it. This list is for giving access to people who don\'t have that administrative right.', 'refactorytools') }}
                    </div>
                </div>

                <h4 class="mb-2 mt-3">{{ __('Reservable asset type colours', 'refactorytools') }}</h4>

                <div class="mb-3">
                    <div class="form-hint mb-2">
                        {{ __('The colour identifies every reservation of that asset type on the calendar and in the list, regardless of which specific item was reserved. Leave a type untouched to keep each item its own colour.', 'refactorytools') }}
                    </div>
                    <div class="refactorytools-color-grid">
                        {% for type in reservation_types %}
                            <label class="refactorytools-color-row">
                                <input type="color" name="reservation_type_color[{{ type.itemtype }}]"
                                       value="{{ type.color }}"
                                       data-refactorytools-default="{{ type.default }}">
                                <span class="refactorytools-color-name">{{ type.label }}</span>
                                <button type="button" class="btn btn-sm btn-ghost-secondary refactorytools-color-reset"
                                        title="{{ __('Back to default', 'refactorytools') }}">
                                    <i class="ti ti-rotate"></i>
                                </button>
                            </label>
                        {% endfor %}
                    </div>
                </div>

                <h4 class="mb-2 mt-3">{{ __('Individual reservable asset colours', 'refactorytools') }}</h4>

                <div class="mb-3">
                    <div class="form-hint mb-2">
                        {{ __('Overrides the type colour above for one specific asset — useful to tell apart two assets of the same type on the calendar (e.g. two different cars).', 'refactorytools') }}
                    </div>
                    <div class="refactorytools-color-grid">
                        {% for item in reservation_items %}
                            <label class="refactorytools-color-row">
                                <input type="color" name="reservation_item_color[{{ item.id }}]"
                                       value="{{ item.color }}"
                                       data-refactorytools-default="{{ item.default }}">
                                <span class="refactorytools-color-name">{{ item.type_name }} — {{ item.name }}</span>
                                <button type="button" class="btn btn-sm btn-ghost-secondary refactorytools-color-reset"
                                        title="{{ __('Back to default', 'refactorytools') }}">
                                    <i class="ti ti-rotate"></i>
                                </button>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

        </div>

        <div class="card-footer text-end">
            <button type="submit" name="update" value="1" class="btn btn-primary">
                {{ __('Save', 'refactorytools') }}
            </button>
        </div>
    </form>
</div>

<script>
    // "Voltar ao padrão": devolve o input ao valor de fábrica do tipo, que o
    // servidor escreveu em data-refactorytools-default. Salvar com a cor igual à
    // padrão é o mesmo que não customizar — Settings::saveTypeColors() guarda
    // só o que difere.
    $(function () {
        $(document).on('click', '.refactorytools-color-reset', function () {
            var $input = $(this).closest('.refactorytools-color-row').find('input[type=color]');
            $input.val($input.data('refactorytools-default'));
        });
    });
</script>
