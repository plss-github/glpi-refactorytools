{#
 # Planner — tela principal do planejamento.
 #
 # Três modos sobre os MESMOS dados: Calendário, Lista e Kanban. O FullCalendar
 # continua sendo o motor de datas nos três — ele decide o período exibido, e
 # Lista e Kanban desenham o que ele carregou. Assim os três nunca discordam
 # sobre o que está no período, e não há uma segunda consulta ao servidor ao
 # trocar de modo.
 #
 # A marcação usa as classes do Tabler que o GLPI 11 já carrega (card, btn,
 # badge, form-check), e o CSS do plugin cuida só do que é específico do
 # planejamento. Assim a tela acompanha o tema claro/escuro e a paleta da
 # instância sem duplicar um sistema de design.
 #}

<div class="planner-page" id="planner-app"
     data-root="{{ root_doc }}"
     data-me="{{ me }}"
     data-today="{{ today }}">

    {# ------------------------------------------------------------------ #}
    {# Barra superior: navegação do período + seletor de modo              #}
    {# ------------------------------------------------------------------ #}
    <div class="planner-topbar">
        <div class="planner-nav">
            <div class="btn-group">
                <button type="button" class="btn btn-sm planner-prev" title="{{ __('Previous', 'planner') }}">
                    <i class="ti ti-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm planner-today">{{ __('Today', 'planner') }}</button>
                <button type="button" class="btn btn-sm planner-next" title="{{ __('Next', 'planner') }}">
                    <i class="ti ti-chevron-right"></i>
                </button>
            </div>
            <span class="planner-period" data-period>&nbsp;</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            {% if creatable_kinds is not empty %}
                <button type="button" class="btn btn-sm btn-primary"
                        data-bs-toggle="modal" data-bs-target="#planner-new-event">
                    <i class="ti ti-plus"></i> {{ __('New event', 'planner') }}
                </button>
            {% endif %}
            <div class="planner-modes btn-group" role="group" aria-label="{{ __('View mode', 'planner') }}">
                <button type="button" class="btn btn-sm" data-mode="calendar">
                    <i class="ti ti-calendar-month"></i> {{ __('Calendar', 'planner') }}
                </button>
                <button type="button" class="btn btn-sm" data-mode="list">
                    <i class="ti ti-list-details"></i> {{ __('List', 'planner') }}
                </button>
                <button type="button" class="btn btn-sm" data-mode="kanban">
                    <i class="ti ti-layout-kanban"></i> {{ __('Kanban', 'planner') }}
                </button>
            </div>
        </div>
    </div>

    {# ------------------------------------------------------------------ #}
    {# Barra secundária: opções do modo ativo + indicadores                #}
    {# ------------------------------------------------------------------ #}
    <div class="planner-subbar">
        <div class="planner-subopts">
            <div class="btn-group planner-ranges" role="group">
                <button type="button" class="btn btn-sm" data-range="day">{{ __('Day', 'planner') }}</button>
                <button type="button" class="btn btn-sm" data-range="week">{{ __('Week', 'planner') }}</button>
                <button type="button" class="btn btn-sm" data-range="month">{{ __('Month', 'planner') }}</button>
            </div>

            {# Alternador, não um quarto período: liga uma raia por pessoa
               mantendo o período escolhido acima. Só faz sentido no
               calendário — Lista e Kanban já identificam a pessoa em cada
               linha ou card. #}
            <button type="button" class="btn btn-sm planner-team-toggle"
                    title="{{ __('One lane per person, same period', 'planner') }}">
                <i class="ti ti-users-group"></i> {{ __('By person', 'planner') }}
            </button>

            {% if can_group_manager_mode %}
                {# Só aparece para quem é `is_manager=1` de pelo menos um
                   grupo com membros visíveis (ver `AccessPolicy::canUseGroupManagerMode`).
                   Ligar isto não muda QUEM aparece na agenda — isso já
                   depende de marcar o grupo na barra lateral — só COMO os
                   compromissos são coloridos: uma cor por pessoa em vez de
                   uma cor por tipo, que passa a virar uma tag de texto. #}
                <button type="button" class="btn btn-sm" id="planner-group-manager-toggle"
                        title="{{ __('Each group member gets a colour; event types become text tags', 'planner') }}">
                    <i class="ti ti-users"></i> {{ __('Group manager view', 'planner') }}
                </button>
            {% endif %}

            <div class="planner-kanban-opts" hidden>
                <span class="planner-subbar-label">{{ __('Group by', 'planner') }}</span>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-sm" data-group="state">{{ __('Status', 'planner') }}</button>
                    <button type="button" class="btn btn-sm" data-group="actor">{{ __('Person', 'planner') }}</button>
                </div>
            </div>
        </div>

        <div class="planner-kpis">
            <div class="planner-kpi">
                <span class="planner-kpi-value" data-kpi="hours">—</span>
                <span class="planner-kpi-label">{{ __('Planned hours', 'planner') }}</span>
            </div>
            <div class="planner-kpi">
                <span class="planner-kpi-value" data-kpi="todo">—</span>
                <span class="planner-kpi-label">{{ __('To do', 'planner') }}</span>
            </div>
            <div class="planner-kpi">
                <span class="planner-kpi-value" data-kpi="done">—</span>
                <span class="planner-kpi-label">{{ __('Completed', 'planner') }}</span>
            </div>
        </div>
    </div>

    <div class="planner-body">

        {# -------------------------------------------------------------- #}
        {# Barra lateral                                                   #}
        {# -------------------------------------------------------------- #}
        <aside class="planner-sidebar card">
            <div class="planner-sidebar-scroll">

                {% if pending_count > 0 %}
                    <a href="{{ root_doc }}/plugins/planner/front/share.php"
                       class="planner-pending alert alert-warning d-block mb-3 py-2 px-3">
                        <i class="ti ti-bell"></i>
                        {{ __('%d access request(s) awaiting your decision', 'planner')|format(pending_count) }}
                    </a>
                {% endif %}

                {% for group in actor_groups %}
                    <div class="planner-section">
                        <div class="planner-section-title">{{ group.label }}</div>
                        <ul class="planner-actors">
                            {% for actor in group.actors %}
                                <li class="planner-actor" data-actor="{{ actor.id }}">
                                    <label class="planner-actor-label">
                                        <input type="checkbox" class="form-check-input planner-actor-toggle"
                                               value="{{ actor.id }}"
                                               data-color="{{ actor.color }}"
                                               data-name="{{ actor.name }}"
                                               {{ (actor.reason == 'self' or (auto_load_team and group.reason == 'team')) ? 'checked' : '' }}>
                                        <span class="planner-avatar" style="--planner-actor-color: {{ actor.color }}">
                                            {% if actor.picture %}
                                                <img src="{{ actor.picture }}" alt="">
                                            {% else %}
                                                {{ actor.initials }}
                                            {% endif %}
                                        </span>
                                        <span class="planner-actor-name">{{ actor.name }}</span>
                                        {% if actor.level == level_busy %}
                                            <span class="badge bg-secondary-lt planner-actor-badge"
                                                  title="{{ __('You only see this person busy times', 'planner') }}">
                                                {{ __('free/busy', 'planner') }}
                                            </span>
                                        {% endif %}
                                    </label>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endfor %}

                <div class="planner-section">
                    <div class="planner-section-title">
                        {{ __('Event types', 'planner') }}
                        {# Cada pessoa pode preferir suas próprias cores, sem
                           depender do administrador nem afetar a tela de
                           ninguém mais (ver `UserColors`). O lápis abre o
                           formulário embutido logo abaixo. #}
                        <button type="button" class="planner-color-edit-toggle" id="planner-color-edit-toggle"
                                title="{{ __('Customise my colours', 'planner') }}">
                            <i class="ti ti-palette"></i>
                        </button>
                    </div>
                    <ul class="planner-types" id="planner-type-list">
                        {% for type in types %}
                            <li>
                                <label class="planner-type-label">
                                    <input type="checkbox" class="form-check-input planner-type-toggle"
                                           value="{{ type.itemtype }}" checked>
                                    <span class="planner-avatar planner-avatar-square planner-avatar-xs planner-type-swatch"
                                          style="--planner-actor-color: {{ type.color }}" data-type-key="{{ type.itemtype }}">
                                        <i class="{{ type.icon }}"></i>
                                    </span>
                                    <span>{{ type.label }}</span>
                                </label>
                            </li>
                        {% endfor %}
                    </ul>
                    <label class="planner-type-label">
                        <input type="checkbox" class="form-check-input" id="planner-show-done" checked>
                        <span>{{ __('Show completed', 'planner') }}</span>
                    </label>

                    {# Formulário de cores pessoais: escondido por padrão,
                       abre com o botão do lápis acima. Um input color por
                       tipo, exatamente como a tela de configuração do
                       administrador — só que grava em `UserColors`, não em
                       `Settings`. #}
                    <form id="planner-color-form" class="planner-color-grid mt-2" hidden
                          method="post" action="{{ root_doc }}/plugins/planner/ajax/save_user_colors.php">
                        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">
                        {% for type in types %}
                            <label class="planner-color-row">
                                <input type="color" name="colors[{{ type.itemtype }}]" value="{{ type.color }}"
                                       data-planner-default="{{ type.default }}">
                                <span class="planner-color-name">{{ type.label }}</span>
                                <button type="button" class="btn btn-sm btn-ghost-secondary planner-color-reset"
                                        title="{{ __('Back to default', 'planner') }}">
                                    <i class="ti ti-rotate"></i>
                                </button>
                            </label>
                        {% endfor %}
                        <button type="submit" class="btn btn-sm btn-primary w-100 mt-1">
                            {{ __('Save my colours', 'planner') }}
                        </button>
                    </form>
                </div>

                {% if technician_panel and technician_panel.tickets|length > 0 %}
                    {# Chamados em que o usuário logado participa como TÉCNICO
                       (`Ticket_User.type = ASSIGN`) — sempre sobre a PRÓPRIA
                       participação, por isso não depende de nenhum direito
                       extra do plugin: é o mesmo recorte que a pessoa já vê em
                       "Meus chamados" na Central. A duração de cada chamado
                       aparece ao passar o mouse (atributo `title` nativo, sem
                       JavaScript). #}
                    <div class="planner-section">
                        <div class="planner-section-title">
                            {{ __('My tickets as technician', 'planner') }}
                        </div>
                        <div class="planner-tech-kpis">
                            <div class="planner-tech-kpi">
                                <span class="planner-tech-kpi-value">{{ technician_panel.planned_hours }}h</span>
                                <span class="planner-tech-kpi-label">{{ __('Planned hours', 'planner') }}</span>
                            </div>
                            <div class="planner-tech-kpi">
                                <span class="planner-tech-kpi-value">{{ technician_panel.realized_hours }}h</span>
                                <span class="planner-tech-kpi-label">{{ __('Realised hours', 'planner') }}</span>
                            </div>
                            <div class="planner-tech-kpi">
                                <span class="planner-tech-kpi-value">{{ technician_panel.total_hours }}h</span>
                                <span class="planner-tech-kpi-label">{{ __('Total hours', 'planner') }}</span>
                            </div>
                        </div>
                        <ul class="planner-tech-tickets">
                            {% for t in technician_panel.tickets %}
                                <li class="planner-tech-ticket" title="{{ t.duration_label }}">
                                    <a href="{{ t.url }}">{{ t.name }}</a>
                                    <span class="badge bg-secondary-lt">{{ t.status_label }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {# Acesso a agendas de terceiros: as duas ações ficam juntas, no
                   fim da barra, porque são sobre a mesma coisa — abrir uma
                   agenda que não é minha. #}
                {% if can_pick_any %}
                    <div class="planner-section">
                        {# O aviso de "Ver todas as agendas" é uma explicação,
                           não uma instrução: ocupava quatro linhas fixas da
                           barra lateral para algo que se lê uma vez. Virou
                           ícone com dica ao passar o mouse, usando o tooltip do
                           Bootstrap que o GLPI já inicializa nas páginas. #}
                        <div class="planner-section-title">
                            {{ __('Open another schedule', 'planner') }}
                            {% if reads_all %}
                                <i class="ti ti-info-circle planner-info"
                                   data-bs-toggle="tooltip" data-bs-placement="top"
                                   title="{{ __('Your profile has "See all schedules": you can open any user schedule, without depending on team, group or sharing.', 'planner') }}"></i>
                            {% endif %}
                        </div>
                        {# Dropdown nativo (select2 com busca via ajax) em vez do
                           wrapper `fields.dropdownField`, que traria rótulo e
                           grade de formulário desnecessários na barra lateral. #}
                        <div class="planner-picker">
                            {{ 'User'|itemtype_dropdown({
                                name: 'planner_add_user',
                                value: 0,
                                entity: session('glpiactive_entity'),
                                entity_sons: session('glpiactive_entity_recursive'),
                                right: 'all',
                                width: '100%'
                            }) }}
                        </div>
                    </div>
                {% elseif can_request %}
                    <div class="planner-section">
                        <div class="planner-section-title">{{ __('Open another schedule', 'planner') }}</div>
                        <a href="{{ root_doc }}/plugins/planner/front/share.php"
                           class="btn btn-sm btn-outline-primary w-100">
                            <i class="ti ti-lock-open"></i>
                            {{ __('Request access to a schedule', 'planner') }}
                        </a>
                    </div>
                {% endif %}

                {% if can_share or reads_all %}
                    <div class="planner-section planner-section-footer">
                        {% if can_share %}
                            <a href="{{ root_doc }}/plugins/planner/front/share.php"
                               class="btn btn-sm btn-ghost-secondary w-100">
                                <i class="ti ti-calendar-share"></i>
                                {{ __('Manage shares', 'planner') }}
                            </a>
                        {% endif %}
                        {% if reads_all %}
                            <a href="{{ root_doc }}/plugins/planner/front/config.form.php"
                               class="btn btn-sm btn-ghost-secondary w-100 mt-1">
                                <i class="ti ti-settings"></i>
                                {{ __('Planner configuration', 'planner') }}
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </aside>

        {# -------------------------------------------------------------- #}
        {# Área principal: um painel por modo                              #}
        {# -------------------------------------------------------------- #}
        <main class="planner-main card">
            <div class="planner-loading" hidden>
                <div class="spinner-border spinner-border-sm"></div>
                {{ __('Loading schedule…', 'planner') }}
            </div>

            <div class="planner-pane" data-pane="calendar">
                <div id="planner-calendar"></div>
            </div>

            <div class="planner-pane" data-pane="list" hidden>
                <div class="planner-list"></div>
            </div>

            <div class="planner-pane" data-pane="kanban" hidden>
                <div class="planner-kanban"></div>
            </div>
        </main>
    </div>
</div>

{# ------------------------------------------------------------------------ #}
{# Novo compromisso                                                          #}
{#                                                                           #}
{# Cobre exatamente o que o planejamento NATIVO também deixa criar direto do #}
{# calendário — Lembrete e as quatro variantes de Evento — porque uma tarefa #}
{# de chamado/mudança/problema/projeto só existe presa a um item já aberto,  #}
{# em nenhuma das duas telas. Posta para `ajax/create_event.php`, endpoint   #}
{# próprio do plugin: o formulário nativo do evento externo tem um gate de   #}
{# direito incondicional que bloquearia quem só tem o direito do plugin.     #}
{# ------------------------------------------------------------------------ #}
{% if creatable_kinds is not empty %}
    <div class="modal fade" id="planner-new-event" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post"
                  action="{{ root_doc }}/plugins/planner/ajax/create_event.php"
                  id="planner-new-event-form">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">

                <div class="modal-header">
                    <h5 class="modal-title">{{ __('New event', 'planner') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="{{ __('Close', 'planner') }}"></button>
                </div>

                <div class="modal-body planner-res-form">
                    <div class="mb-3">
                        <label class="form-label required" for="planner-event-kind">{{ __('Type', 'planner') }}</label>
                        <select class="form-select" id="planner-event-kind" name="kind" required>
                            {% for kind in creatable_kinds %}
                                <option value="{{ kind.key }}">{{ kind.label }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required" for="planner-event-name">{{ __('Title', 'planner') }}</label>
                        <input type="text" class="form-control" id="planner-event-name" name="name" required>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label required" for="planner-event-begin">{{ __('Start', 'planner') }}</label>
                            <input type="datetime-local" class="form-control" id="planner-event-begin"
                                   value="{{ default_event_begin }}" required>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label required" for="planner-event-end">{{ __('End', 'planner') }}</label>
                            <input type="datetime-local" class="form-control" id="planner-event-end"
                                   value="{{ default_event_end }}" required>
                        </div>
                    </div>
                    <input type="hidden" name="begin" id="planner-event-begin-raw">
                    <input type="hidden" name="end" id="planner-event-end-raw">

                    <div class="mb-3">
                        <label class="form-label" for="planner-event-text">{{ __('Description', 'planner') }}</label>
                        <textarea class="form-control" id="planner-event-text" name="text" rows="2"></textarea>
                    </div>

                    {# Recorrência: só se aplica às 4 variantes de Evento — o
                       widget nativo (`showRepetitionForm`) escreve os campos
                       `rrule[...]`, que `PlanningExternalEvent::add()` já
                       sabe converter. Lembrete não tem coluna de recorrência
                       no banco, então o bloco fica escondido nesse caso. #}
                    <div id="planner-event-rrule">
                        {{ call('PlanningExternalEvent::showRepetitionForm', ['', {rand: random()}])|raw }}
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">
                        {{ __('Cancel', 'planner') }}
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-calendar-plus me-1"></i>{{ __('Create', 'planner') }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        $(function () {
            var $kindSelect = $('#planner-event-kind');
            var $rrule = $('#planner-event-rrule');

            function toSql(value) {
                return value ? value.replace('T', ' ') + ':00' : '';
            }

            function toggleRrule() {
                // "Lembrete" é a única opção sem coluna de recorrência no
                // banco — some com o bloco nesse caso, em vez de deixá-lo
                // visível prometendo algo que o envio ignoraria.
                $rrule.prop('hidden', $kindSelect.val() === {{ constant('GlpiPlugin\\Planner\\EventTypes::REMINDER')|json_encode|raw }});
            }

            $kindSelect.on('change', toggleRrule);
            toggleRrule();

            $('#planner-new-event-form').on('submit', function () {
                $('#planner-event-begin-raw').val(toSql($('#planner-event-begin').val()));
                $('#planner-event-end-raw').val(toSql($('#planner-event-end').val()));
            });
        });
    </script>
{% endif %}

<script>
    $(function () {
        // Cores pessoais: abrir/fechar o formulário, pré-visualizar no
        // marcador enquanto a pessoa escolhe, e "voltar ao padrão" por tipo.
        // A gravação em si é um POST normal (ver ajax/save_user_colors.php);
        // a página recarrega depois e os eventos já vêm coloridos do servidor.
        $('#planner-color-edit-toggle').on('click', function () {
            $(this).toggleClass('is-active');
            $('#planner-color-form').prop('hidden', function (_, hidden) { return !hidden; });
        });

        $('#planner-color-form').on('input', 'input[type=color]', function () {
            var key = $(this).closest('.planner-color-row').find('input').attr('name')
                .replace('colors[', '').replace(']', '');
            $('#planner-type-list .planner-type-swatch[data-type-key="' + key + '"]')
                .css('--planner-actor-color', $(this).val());
        });

        $('#planner-color-form').on('click', '.planner-color-reset', function () {
            $(this).closest('.planner-color-row').find('input[type=color]')
                .each(function () { $(this).val($(this).data('planner-default')).trigger('input'); });
        });

        GlpiPlanner.init({
            root_doc: {{ root_doc|json_encode|raw }},
            events_url: {{ (root_doc ~ '/plugins/planner/ajax/events.php')|json_encode|raw }},
            me: {{ me }},
            default_mode: {{ default_mode|json_encode|raw }},
            labels: {
                busy: {{ __('Busy', 'planner')|json_encode|raw }},
                no_actor: {{ __('Select at least one schedule in the sidebar.', 'planner')|json_encode|raw }},
                no_event: {{ __('No events in this period.', 'planner')|json_encode|raw }},
                person: {{ __('Person', 'planner')|json_encode|raw }},
                allday: {{ __('All day', 'planner')|json_encode|raw }},
                state_info: {{ __('Information', 'planner')|json_encode|raw }},
                state_todo: {{ __('To do', 'planner')|json_encode|raw }},
                state_done: {{ __('Done', 'planner')|json_encode|raw }},
                col_when: {{ __('When', 'planner')|json_encode|raw }},
                col_who: {{ __('Person', 'planner')|json_encode|raw }},
                col_type: {{ __('Type', 'planner')|json_encode|raw }},
                col_subject: {{ __('Event', 'planner')|json_encode|raw }},
                col_state: {{ __('Status', 'planner')|json_encode|raw }},
                saved: {{ __('Schedule updated.', 'planner')|json_encode|raw }},
                save_denied: {{ __('You are not allowed to move this event.', 'planner')|json_encode|raw }},
                save_failed: {{ __('Could not save the new time.', 'planner')|json_encode|raw }},
                manager_note: {{ __('Manager note', 'planner')|json_encode|raw }},
                add_note: {{ __('Add a note', 'planner')|json_encode|raw }},
                edit_note: {{ __('Edit note', 'planner')|json_encode|raw }},
                note_saved: {{ __('Note saved.', 'planner')|json_encode|raw }},
                save: {{ __('Save', 'planner')|json_encode|raw }},
                cancel: {{ __('Cancel', 'planner')|json_encode|raw }}
            }
        });
    });
</script>
