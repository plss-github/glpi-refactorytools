{#
 # Planner — tela de Reservas remodelada.
 #
 # Mesma estrutura da agenda (mesmas classes, mesmo JavaScript), com um eixo
 # diferente: cada faixa é um ITEM RESERVÁVEL, não uma pessoa. Reaproveitar as
 # classes `planner-*` não é economia de digitação — é o que garante que as
 # duas telas continuem parecidas quando uma delas mudar.
 #
 # Sem Kanban aqui: uma reserva responde a duas perguntas, qual item e quando,
 # e Calendário e Lista já cobrem as duas.
 #}

{# `planner-page-reservations` é o gancho de CSS que diferencia as duas telas
   onde o significado muda: uma reserva "encerrada" é só uma que já passou,
   não uma que foi cancelada. #}
<div class="planner-page planner-page-reservations" id="planner-app"
     data-root="{{ root_doc }}"
     data-me="{{ me }}"
     data-today="{{ today }}">

    <div class="planner-topbar">
        <div class="planner-nav">
            <div class="btn-group">
                <button type="button" class="btn btn-sm planner-prev" title="{{ __('Previous', 'planner') }}">
                    <i class="ti ti-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm planner-today">{{ __('Today', 'planner') }}</button>
                <button type="button" class="btn btn-sm planner-next" title="{{ __('Next', 'planner') }}">
                    <i class="ti ti-chevron-right"></i>
                </button>
            </div>
            <span class="planner-period" data-period>&nbsp;</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            {% if can_reserve and items_count > 0 %}
                <button type="button" class="btn btn-sm btn-primary"
                        data-bs-toggle="modal" data-bs-target="#planner-new-reservation">
                    <i class="ti ti-plus"></i> {{ __('New reservation', 'planner') }}
                </button>
            {% endif %}
            <div class="planner-modes btn-group" role="group" aria-label="{{ __('View mode', 'planner') }}">
                <button type="button" class="btn btn-sm" data-mode="calendar">
                    <i class="ti ti-calendar-month"></i> {{ __('Calendar', 'planner') }}
                </button>
                <button type="button" class="btn btn-sm" data-mode="list">
                    <i class="ti ti-list-details"></i> {{ __('List', 'planner') }}
                </button>
            </div>
        </div>
    </div>

    <div class="planner-subbar">
        <div class="planner-subopts">
            <div class="btn-group planner-ranges" role="group">
                <button type="button" class="btn btn-sm" data-range="day">{{ __('Day', 'planner') }}</button>
                <button type="button" class="btn btn-sm" data-range="week">{{ __('Week', 'planner') }}</button>
                <button type="button" class="btn btn-sm" data-range="month">{{ __('Month', 'planner') }}</button>
            </div>

            <button type="button" class="btn btn-sm planner-team-toggle"
                    title="{{ __('One lane per item, same period', 'planner') }}">
                <i class="ti ti-layout-rows"></i> {{ __('By item', 'planner') }}
            </button>
        </div>

        <div class="planner-kpis">
            <div class="planner-kpi">
                <span class="planner-kpi-value" data-kpi="count">—</span>
                <span class="planner-kpi-label">{{ __('Reservations', 'planner') }}</span>
            </div>
        </div>
    </div>

    <div class="planner-body">

        <aside class="planner-sidebar card">
            <div class="planner-sidebar-scroll">

                {% if items_count == 0 %}
                    <div class="planner-hint">
                        <i class="ti ti-info-circle"></i>
                        {{ __('No reservable item is available in this entity. An item becomes reservable from its own form, under the Reservations tab.', 'planner') }}
                    </div>
                {% else %}
                    {# A barra lateral marca TIPOS de ativo, não aparelhos.
                       Marcar "Computador" traz todos os computadores
                       reserváveis; cada aparelho vira uma faixa na visão Por
                       item. Uma lista aparelho a aparelho não escala, e o que
                       se quer quase sempre é "ver os computadores". #}
                    <div class="planner-section">
                        <div class="planner-section-title">{{ __('Asset types', 'planner') }}</div>
                        <ul class="planner-actors">
                            {% for type in types %}
                                <li class="planner-actor" data-actor="{{ type.itemtype }}">
                                    <label class="planner-actor-label">
                                        <input type="checkbox" class="form-check-input planner-actor-toggle"
                                               value="{{ type.itemtype }}"
                                               data-color="{{ type.color }}"
                                               data-name="{{ type.label }}" checked>
                                        <span class="planner-avatar planner-avatar-square"
                                              style="--planner-actor-color: {{ type.color }}">
                                            <i class="{{ type.icon }}"></i>
                                        </span>
                                        <span class="planner-actor-name">{{ type.label }}</span>
                                        <span class="badge bg-secondary-lt planner-actor-badge">{{ type.count }}</span>
                                    </label>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="planner-section">
                        <div class="planner-section-title">{{ __('Filters', 'planner') }}</div>
                        <label class="planner-type-label">
                            {# `data-planner-flag` faz o JavaScript mandar esta
                               caixa como parâmetro na busca de eventos, sem
                               precisar de código específico desta tela.
                               Marcada por padrão: o uso mais comum da tela é
                               conferir as próprias reservas. #}
                            <input type="checkbox" class="form-check-input planner-type-toggle"
                                   id="planner-only-mine" data-planner-flag="only_mine" checked>
                            <span>{{ __('Only my reservations', 'planner') }}</span>
                        </label>
                        <label class="planner-type-label">
                            <input type="checkbox" class="form-check-input" id="planner-show-done" checked>
                            <span>{{ __('Show finished', 'planner') }}</span>
                        </label>
                    </div>
                {% endif %}

                {% if can_manage %}
                    <div class="planner-section planner-section-footer">
                        <a href="{{ root_doc }}/front/reservationitem.php"
                           class="btn btn-sm btn-ghost-secondary w-100">
                            <i class="ti ti-settings"></i>
                            {{ __('Manage reservable items', 'planner') }}
                        </a>
                    </div>
                {% endif %}
            </div>
        </aside>

        <main class="planner-main card">
            <div class="planner-loading" hidden>
                <div class="spinner-border spinner-border-sm"></div>
                {{ __('Loading reservations…', 'planner') }}
            </div>

            <div class="planner-pane" data-pane="calendar">
                <div id="planner-calendar"></div>
            </div>

            <div class="planner-pane" data-pane="list" hidden>
                <div class="planner-list"></div>
            </div>
        </main>
    </div>
</div>

{# ------------------------------------------------------------------------ #}
{# Nova reserva                                                              #}
{#                                                                           #}
{# O formulário posta para `front/reservation.form.php` do PRÓPRIO GLPI, que #}
{# chama `Reservation::handleAddForm()`. É esse método que confere se o item #}
{# já está reservado no período, aplica o direito de criar para outra pessoa #}
{# e dispara a notificação. Um endpoint próprio teria que reimplementar a    #}
{# checagem de conflito — e uma reserva dupla é exatamente o erro que esta   #}
{# tela existe para evitar.                                                  #}
{# ------------------------------------------------------------------------ #}
{% if can_reserve and items_count > 0 %}
    <div class="modal fade" id="planner-new-reservation" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post"
                  action="{{ root_doc }}/front/reservation.form.php"
                  id="planner-new-reservation-form">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">
                <input type="hidden" name="add" value="1">

                <div class="modal-header">
                    <h5 class="modal-title">{{ __('New reservation', 'planner') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="{{ __('Close', 'planner') }}"></button>
                </div>

                <div class="modal-body planner-res-form">
                    {# Itens agrupados pelo tipo: numa instalação com muitos
                       ativos reserváveis, uma lista plana obriga a procurar o
                       aparelho no meio de tudo. #}
                    <div class="mb-3">
                        <label class="form-label required" for="planner-res-item">
                            {{ __('Reservable item', 'planner') }}
                        </label>
                        <select class="form-select" id="planner-res-item" name="items[]" required>
                            <option value="" selected disabled>{{ __('Choose an item', 'planner') }}</option>
                            {% for type in types %}
                                <optgroup label="{{ type.label }}">
                                    {% for item in items %}
                                        {% if item.itemtype == type.itemtype %}
                                            <option value="{{ item.id }}">{{ item.name }}</option>
                                        {% endif %}
                                    {% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label required" for="planner-res-begin">{{ __('Start', 'planner') }}</label>
                            <input type="datetime-local" class="form-control" id="planner-res-begin"
                                   value="{{ default_begin }}" required>
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label required" for="planner-res-end">{{ __('End', 'planner') }}</label>
                            <input type="datetime-local" class="form-control" id="planner-res-end"
                                   value="{{ default_end }}" required>
                        </div>
                    </div>

                    {# O core espera 'Y-m-d H:i:s'; o input datetime-local
                       entrega 'Y-m-dTH:i'. A conversão acontece no envio e vai
                       nestes campos ocultos. #}
                    <input type="hidden" name="resa[begin]" id="planner-res-begin-raw">
                    <input type="hidden" name="resa[end]" id="planner-res-end-raw">

                    <div class="mb-3">
                        <label class="form-label" for="planner-res-comment">{{ __('Comment', 'planner') }}</label>
                        <textarea class="form-control" id="planner-res-comment" name="comment" rows="2"
                                  placeholder="{{ __('What is it for? Optional.', 'planner') }}"></textarea>
                    </div>

                    {# Aviso escrito para quem reserva, não para quem mantém o
                       sistema: diz o que vai acontecer com ELE, sem citar o
                       nome do produto nem o mecanismo interno. #}
                    <div class="planner-res-note">
                        <i class="ti ti-info-circle"></i>
                        <span>{{ __('The item is held only for you during this period. If someone has already reserved it, we will tell you and nothing is saved.', 'planner') }}</span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">
                        {{ __('Cancel', 'planner') }}
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-calendar-plus me-1"></i>{{ __('Reserve', 'planner') }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        $(function () {
            $('#planner-new-reservation-form').on('submit', function () {
                // 'Y-m-dTH:i' -> 'Y-m-d H:i:s'. Sem os segundos o MySQL até
                // aceita, mas o valor gravado fica diferente do que o resto do
                // GLPI escreve nessas colunas.
                var toSql = function (value) {
                    return value ? value.replace('T', ' ') + ':00' : '';
                };
                $('#planner-res-begin-raw').val(toSql($('#planner-res-begin').val()));
                $('#planner-res-end-raw').val(toSql($('#planner-res-end').val()));
            });
        });
    </script>
{% endif %}

<script>
    $(function () {
        GlpiPlanner.init({
            root_doc: {{ root_doc|json_encode|raw }},
            events_url: {{ (root_doc ~ '/plugins/planner/ajax/reservation_events.php')|json_encode|raw }},
            me: {{ me }},
            default_mode: {{ default_mode|json_encode|raw }},
            // O eixo desta tela é o item reservável, não a pessoa.
            actor_param: 'itemtypes',
            resource_prefix: {{ constant('GlpiPlugin\\Planner\\ReservationView::RESOURCE_PREFIX')|json_encode|raw }},
            // Faixas aqui são itens, não pessoas: não existe reatribuir uma
            // reserva arrastando de uma faixa para outra.
            resource_itemtype: null,
            labels: {
                no_actor: {{ __('Select at least one asset type in the sidebar.', 'planner')|json_encode|raw }},
                no_event: {{ __('No reservation in this period.', 'planner')|json_encode|raw }},
                person: {{ __('Item', 'planner')|json_encode|raw }},
                allday: {{ __('All day', 'planner')|json_encode|raw }},
                col_when: {{ __('When', 'planner')|json_encode|raw }},
                col_who: {{ __('Item', 'planner')|json_encode|raw }},
                col_type: {{ __('Note', 'planner')|json_encode|raw }},
                col_subject: {{ __('Reserved by', 'planner')|json_encode|raw }},
                col_state: {{ __('Status', 'planner')|json_encode|raw }}
            }
        });
    });
</script>
