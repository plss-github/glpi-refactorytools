{#
 # Planner — tela de Reservas remodelada.
 #
 # Mesma estrutura da agenda (mesmas classes, mesmo JavaScript), com um eixo
 # diferente: cada faixa é um ITEM RESERVÁVEL, não uma pessoa. Reaproveitar as
 # classes `planner-*` não é economia de digitação — é o que garante que as
 # duas telas continuem parecidas quando uma delas mudar.
 #
 # Sem Kanban aqui: uma reserva responde a duas perguntas, qual item e quando,
 # e Calendário e Lista já cobrem as duas.
 #}

{# `planner-page-reservations` é o gancho de CSS que diferencia as duas telas
   onde o significado muda: uma reserva "encerrada" é só uma que já passou,
   não uma que foi cancelada. #}
<div class="planner-page planner-page-reservations" id="planner-app"
     data-root="{{ root_doc }}"
     data-me="{{ me }}"
     data-today="{{ today }}">

    <div class="planner-topbar">
        <div class="planner-nav">
            <div class="btn-group">
                <button type="button" class="btn btn-sm planner-prev" title="{{ __('Previous', 'planner') }}">
                    <i class="ti ti-chevron-left"></i>
                </button>
                <button type="button" class="btn btn-sm planner-today">{{ __('Today', 'planner') }}</button>
                <button type="button" class="btn btn-sm planner-next" title="{{ __('Next', 'planner') }}">
                    <i class="ti ti-chevron-right"></i>
                </button>
            </div>
            <span class="planner-period" data-period>&nbsp;</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            {% if can_reserve and items_count > 0 %}
                <button type="button" class="btn btn-sm btn-primary"
                        data-bs-toggle="modal" data-bs-target="#planner-new-reservation">
                    <i class="ti ti-plus"></i> {{ __('New reservation', 'planner') }}
                </button>
            {% endif %}
            <div class="planner-modes btn-group" role="group" aria-label="{{ __('View mode', 'planner') }}">
                <button type="button" class="btn btn-sm" data-mode="calendar">
                    <i class="ti ti-calendar-month"></i> {{ __('Calendar', 'planner') }}
                </button>
                <button type="button" class="btn btn-sm" data-mode="list">
                    <i class="ti ti-list-details"></i> {{ __('List', 'planner') }}
                </button>
            </div>
        </div>
    </div>

    <div class="planner-subbar">
        <div class="planner-subopts">
            <div class="btn-group planner-ranges" role="group">
                <button type="button" class="btn btn-sm" data-range="day">{{ __('Day', 'planner') }}</button>
                <button type="button" class="btn btn-sm" data-range="week">{{ __('Week', 'planner') }}</button>
                <button type="button" class="btn btn-sm" data-range="month">{{ __('Month', 'planner') }}</button>
            </div>

            <button type="button" class="btn btn-sm planner-team-toggle"
                    title="{{ __('One lane per item, same period', 'planner') }}">
                <i class="ti ti-layout-rows"></i> {{ __('By item', 'planner') }}
            </button>
        </div>

        <div class="planner-kpis">
            <div class="planner-kpi">
                <span class="planner-kpi-value" data-kpi="count">—</span>
                <span class="planner-kpi-label">{{ __('Reservations', 'planner') }}</span>
            </div>
        </div>
    </div>

    <div class="planner-body">

        <aside class="planner-sidebar card">
            <div class="planner-sidebar-scroll">

                {% if items_count == 0 %}
                    <div class="planner-hint">
                        <i class="ti ti-info-circle"></i>
                        {{ __('No reservable item is available in this entity. An item becomes reservable from its own form, under the Reservations tab.', 'planner') }}
                    </div>
                {% else %}
                    {# Uma seção só, "Filtros": os tipos de ativo e as duas
                       caixas booleanas mexem na mesma coisa — o que aparece
                       no calendário/lista agora. As duas caixas vêm PRIMEIRO
                       (são a última opção de filtro antes da lista de tipos,
                       por pedido explícito) e os tipos de ativo, que são uma
                       lista mais longa e variável conforme a instalação,
                       ficam por último.
                       A barra lateral marca TIPOS de ativo, não aparelhos.
                       Marcar "Computador" traz todos os computadores
                       reserváveis; cada aparelho vira uma faixa na visão Por
                       item. Uma lista aparelho a aparelho não escala, e o que
                       se quer quase sempre é "ver os computadores". #}
                    <div class="planner-section">
                        <div class="planner-section-title">{{ __('Filters', 'planner') }}</div>

                        <label class="planner-type-label">
                            {# `data-planner-flag` faz o JavaScript mandar esta
                               caixa como parâmetro na busca de eventos, sem
                               precisar de código específico desta tela.
                               Marcada por padrão: o uso mais comum da tela é
                               conferir as próprias reservas. #}
                            <input type="checkbox" class="form-check-input planner-type-toggle"
                                   id="planner-only-mine" data-planner-flag="only_mine" checked>
                            <span>{{ __('Only my reservations', 'planner') }}</span>
                        </label>
                        <label class="planner-type-label">
                            <input type="checkbox" class="form-check-input" id="planner-show-done" checked>
                            <span>{{ __('Show finished', 'planner') }}</span>
                        </label>

                        <div class="planner-section-subtitle">{{ __('Asset types', 'planner') }}</div>
                        <ul class="planner-actors">
                            {% for type in types %}
                                <li class="planner-actor" data-actor="{{ type.itemtype }}">
                                    <label class="planner-actor-label">
                                        <input type="checkbox" class="form-check-input planner-actor-toggle"
                                               value="{{ type.itemtype }}"
                                               data-color="{{ type.color }}"
                                               data-name="{{ type.label }}" checked>
                                        <span class="planner-avatar planner-avatar-square"
                                              style="--planner-actor-color: {{ type.color }}">
                                            <i class="{{ type.icon }}"></i>
                                        </span>
                                        <span class="planner-actor-name">{{ type.label }}</span>
                                        <span class="badge bg-secondary-lt planner-actor-badge">{{ type.count }}</span>
                                    </label>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}

                {% if can_manage %}
                    <div class="planner-section planner-section-footer">
                        <a href="{{ root_doc }}/front/reservationitem.php"
                           class="btn btn-sm btn-ghost-secondary w-100">
                            <i class="ti ti-settings"></i>
                            {{ __('Manage reservable items', 'planner') }}
                        </a>
                    </div>
                {% endif %}
            </div>
        </aside>

        <main class="planner-main card">
            <div class="planner-loading" hidden>
                <div class="spinner-border spinner-border-sm"></div>
                {{ __('Loading reservations…', 'planner') }}
            </div>

            <div class="planner-pane" data-pane="calendar">
                <div id="planner-calendar"></div>
            </div>

            <div class="planner-pane" data-pane="list" hidden>
                <div class="planner-list"></div>
            </div>
        </main>
    </div>
</div>

{# ------------------------------------------------------------------------ #}
{# Nova reserva                                                              #}
{#                                                                           #}
{# A ordem dos campos é deliberada: DATA primeiro, item por último. Só depois#}
{# de saber o período dá para saber o que está livre — mostrar a lista       #}
{# completa (livre ou não) e só avisar do conflito depois de preencher tudo  #}
{# é exatamente o problema que esta tela substitui (reservas combinadas num  #}
{# chat, sem checar disponibilidade de verdade). O tipo de ativo e o item só #}
{# ficam habilitados depois que a data é preenchida, e as opções vêm de      #}
{# `ajax/reservation_availability.php` — só o que está de fato livre aparece.#}
{#                                                                           #}
{# Posta para `ajax/create_reservation.php`, endpoint do PRÓPRIO plugin, não #}
{# para o formulário nativo do GLPI: ele reconfere a disponibilidade no      #}
{# servidor (a lista do cliente é só conveniência) e exige a justificativa   #}
{# antes de delegar a gravação para `Reservation::handleAddForm()` do core — #}
{# a mesma rotina que confere conflito e expande a recorrência.              #}
{# ------------------------------------------------------------------------ #}
{% if can_reserve and items_count > 0 %}
    <div class="modal fade" id="planner-new-reservation" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" method="post"
                  action="{{ root_doc }}/plugins/planner/ajax/create_reservation.php"
                  id="planner-new-reservation-form">
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf }}">

                <div class="modal-header">
                    <h5 class="modal-title">{{ __('New reservation', 'planner') }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                            aria-label="{{ __('Close', 'planner') }}"></button>
                </div>

                <div class="modal-body planner-res-form">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-sm-6">
                            <label class="form-label required" for="planner-res-begin">{{ __('Start', 'planner') }}</label>
                            {# Texto simples + flatpickr, não `type="datetime-local"`:
                               o widget nativo do navegador para esse tipo de
                               campo varia demais de um SO/navegador para outro
                               e em vários deles não dá pra digitar a hora
                               direto, só clicar nas setinhas. flatpickr é o
                               que o resto do GLPI já usa para isso. #}
                            <input type="text" class="form-control" id="planner-res-begin"
                                   name="resa[begin]" value="{{ default_begin }}" required autocomplete="off">
                        </div>
                        <div class="col-12 col-sm-6">
                            <label class="form-label required" for="planner-res-end">{{ __('End', 'planner') }}</label>
                            <input type="text" class="form-control" id="planner-res-end"
                                   name="resa[end]" value="{{ default_end }}" required autocomplete="off">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required" for="planner-res-type">{{ __('Asset type', 'planner') }}</label>
                        <select class="form-select" id="planner-res-type" required disabled>
                            <option value="">{{ __('Fill in the dates above first', 'planner') }}</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required" for="planner-res-item">
                            {{ __('Reservable item', 'planner') }}
                        </label>
                        <select class="form-select" id="planner-res-item" name="items[]" required disabled>
                            <option value="">—</option>
                        </select>
                        <div class="form-hint" id="planner-res-availability-hint"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required" for="planner-res-comment">
                            {{ __('Reservation justification', 'planner') }}
                        </label>
                        <textarea class="form-control" id="planner-res-comment" name="comment" rows="2"
                                  placeholder="{{ __('What is it for?', 'planner') }}" required></textarea>
                    </div>

                    {# Recorrência: mesmos nomes de campo (`periodicity[...]`)
                       que o formulário nativo de reserva usa, então
                       `Reservation::handleAddForm()` entende sem tradução. #}
                    <div class="mb-1">
                        <label class="form-label" for="planner-res-periodicity">{{ __('Repeat', 'planner') }}</label>
                        <select class="form-select" id="planner-res-periodicity" name="periodicity[type]">
                            <option value="">{{ __('Does not repeat', 'planner') }}</option>
                            <option value="day">{{ __('Every day', 'planner') }}</option>
                            <option value="week">{{ __('Every week', 'planner') }}</option>
                            <option value="month">{{ __('Every month', 'planner') }}</option>
                        </select>
                    </div>

                    <div class="planner-res-periodicity-detail" hidden>
                        <div class="row g-2 mt-1">
                            <div class="col-12 col-sm-6">
                                <label class="form-label" for="planner-res-periodicity-end">{{ __('Repeat until', 'planner') }}</label>
                                <input type="date" class="form-control" id="planner-res-periodicity-end"
                                       name="periodicity[end]">
                            </div>
                            <div class="col-12 col-sm-6 planner-res-periodicity-month" hidden>
                                <label class="form-label" for="planner-res-periodicity-subtype">{{ __('Monthly pattern', 'planner') }}</label>
                                <select class="form-select" id="planner-res-periodicity-subtype" name="periodicity[subtype]">
                                    <option value="date">{{ __('Same date every month', 'planner') }}</option>
                                    <option value="day">{{ __('Same weekday every month', 'planner') }}</option>
                                </select>
                            </div>
                        </div>
                        <div class="planner-res-periodicity-week" hidden>
                            <div class="form-label mt-2 mb-1">{{ __('On these days', 'planner') }}</div>
                            <div class="d-flex flex-wrap gap-2">
                                {% for day, label in {'Monday': __('Mon', 'planner'), 'Tuesday': __('Tue', 'planner'), 'Wednesday': __('Wed', 'planner'), 'Thursday': __('Thu', 'planner'), 'Friday': __('Fri', 'planner'), 'Saturday': __('Sat', 'planner'), 'Sunday': __('Sun', 'planner')} %}
                                    <label class="planner-res-day-toggle">
                                        <input type="checkbox" name="periodicity[days][{{ day }}]" value="1">
                                        <span>{{ label }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    {# Aviso escrito para quem reserva, não para quem mantém o
                       sistema: diz o que vai acontecer com ELE, sem citar o
                       nome do produto nem o mecanismo interno. #}
                    <div class="planner-res-note mt-3">
                        <i class="ti ti-info-circle"></i>
                        <span>{{ __('The item is held only for you during this period. If someone has already reserved it, we will tell you and nothing is saved.', 'planner') }}</span>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost-secondary" data-bs-dismiss="modal">
                        {{ __('Cancel', 'planner') }}
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-calendar-plus me-1"></i>{{ __('Reserve', 'planner') }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Comportamento do modal de nova reserva. Fica aqui, e não no
        // planner.js compartilhado, porque é específico desta tela: o
        // planner.js carrega em TODA página do GLPI (hook `add_javascript`),
        // e este código só existe onde o formulário existe.
        $(function () {
            var $modal   = $('#planner-new-reservation');
            var $begin   = $('#planner-res-begin');
            var $end     = $('#planner-res-end');
            var $type    = $('#planner-res-type');
            var $item    = $('#planner-res-item');
            var $hint    = $('#planner-res-availability-hint');
            var labels = {
                choose_type: {{ __('Choose an asset type', 'planner')|json_encode|raw }},
                choose_item: {{ __('Choose an item', 'planner')|json_encode|raw }},
                fill_dates:  {{ __('Fill in the dates above first', 'planner')|json_encode|raw }},
                no_items:    {{ __('Nothing is free for this period.', 'planner')|json_encode|raw }}
            };
            var availableItems = [];
            var fetchToken = 0;

            // flatpickr, não o `type="datetime-local"` nativo: dá pra digitar
            // a data inteira direto no campo (`allowInput: true` — sem isso o
            // texto visível fica só de leitura, e só o clique no calendário
            // funcionaria), e o formato batido ('Y-m-d H:i:S') já é o que o
            // core espera, sem conversão nenhuma no envio.
            function initDateTime($el) {
                if ($.fn.flatpickr) {
                    $el.flatpickr({
                        enableTime: true,
                        time_24hr: true,
                        dateFormat: 'Y-m-d H:i:S',
                        allowInput: true,
                        onClose: function () { $el.trigger('change'); }
                    });
                }
            }
            initDateTime($begin);
            initDateTime($end);

            // Select2 dentro de um modal Bootstrap precisa de `dropdownParent`
            // apontando para o próprio modal — sem isso, o painel da lista
            // renderiza atrás do fundo escurecido ou fora de posição, porque
            // o modal move o foco e recorta o overflow do body.
            function initSelect2($el, placeholder) {
                if ($.fn.select2) {
                    $el.select2({ dropdownParent: $modal, width: '100%', placeholder: placeholder });
                }
            }

            function setOptions($select, options, placeholder) {
                var current = $select.val();
                $select.empty().append($('<option></option>').val('').text(placeholder));
                options.forEach(function (opt) {
                    $select.append($('<option></option>').val(opt.value).text(opt.text));
                });
                // Select2 precisa ser reconstruído depois de trocar as opções
                // à mão; só chamar `.trigger('change')` não refaz a lista.
                if ($.fn.select2 && $select.data('select2')) {
                    $select.select2('destroy');
                }
                initSelect2($select, placeholder);
                if (current && options.some(function (o) { return String(o.value) === String(current); })) {
                    $select.val(current).trigger('change.select2');
                }
            }

            function applyTypeFilter() {
                var type = $type.val();
                var opts = availableItems
                    .filter(function (it) { return !type || it.itemtype === type; })
                    .map(function (it) { return { value: it.id, text: it.type_name + ' — ' + it.name }; });
                setOptions($item, opts, opts.length ? labels.choose_item : labels.no_items);
                $item.prop('disabled', opts.length === 0);
            }

            function refreshAvailability() {
                var begin = $begin.val();
                var end = $end.val();

                if (!begin || !end || begin >= end) {
                    return;
                }

                var token = ++fetchToken;

                $.getJSON({{ (root_doc ~ '/plugins/planner/ajax/reservation_availability.php')|json_encode|raw }}, {
                    begin: begin,
                    end: end
                }).done(function (data) {
                    // Uma resposta antiga (a pessoa mudou a data de novo antes
                    // desta voltar) não deve sobrescrever um resultado mais
                    // novo que talvez já tenha chegado.
                    if (token !== fetchToken) {
                        return;
                    }

                    availableItems = data.items || [];

                    var typeOpts = (data.types || []).map(function (t) {
                        return { value: t.itemtype, text: t.label + ' (' + t.count + ')' };
                    });
                    setOptions($type, typeOpts, typeOpts.length ? labels.choose_type : labels.no_items);
                    $type.prop('disabled', typeOpts.length === 0);

                    applyTypeFilter();

                    $hint.text(typeOpts.length === 0 ? labels.no_items : '');
                });
            }

            $begin.on('change', refreshAvailability);
            $end.on('change', refreshAvailability);
            $type.on('change', applyTypeFilter);

            $modal.on('shown.bs.modal', function () {
                initSelect2($type, labels.fill_dates);
                initSelect2($item, labels.fill_dates);
                refreshAvailability();
            });

            // Recorrência: mostra só os campos que fazem sentido para o tipo
            // escolhido (dias da semana só para "toda semana", padrão mensal
            // só para "todo mês").
            $(document).on('change', '.planner-res-day-toggle input', function () {
                $(this).closest('.planner-res-day-toggle').toggleClass('is-checked', this.checked);
            });

            $('#planner-res-periodicity').on('change', function () {
                var type = $(this).val();
                $('.planner-res-periodicity-detail').prop('hidden', !type);
                $('.planner-res-periodicity-week').prop('hidden', type !== 'week');
                $('.planner-res-periodicity-month').prop('hidden', type !== 'month');
            });

        });
    </script>
{% endif %}

<script>
    $(function () {
        GlpiPlanner.init({
            root_doc: {{ root_doc|json_encode|raw }},
            events_url: {{ (root_doc ~ '/plugins/planner/ajax/reservation_events.php')|json_encode|raw }},
            me: {{ me }},
            default_mode: {{ default_mode|json_encode|raw }},
            // O eixo desta tela é o item reservável, não a pessoa.
            actor_param: 'itemtypes',
            resource_prefix: {{ constant('GlpiPlugin\\Planner\\ReservationView::RESOURCE_PREFIX')|json_encode|raw }},
            // Faixas aqui são itens, não pessoas: não existe reatribuir uma
            // reserva arrastando de uma faixa para outra.
            resource_itemtype: null,
            labels: {
                no_actor: {{ __('Select at least one asset type in the sidebar.', 'planner')|json_encode|raw }},
                no_event: {{ __('No reservation in this period.', 'planner')|json_encode|raw }},
                person: {{ __('Item', 'planner')|json_encode|raw }},
                allday: {{ __('All day', 'planner')|json_encode|raw }},
                col_when: {{ __('When', 'planner')|json_encode|raw }},
                col_who: {{ __('Item', 'planner')|json_encode|raw }},
                col_type: {{ __('Note', 'planner')|json_encode|raw }},
                col_subject: {{ __('Reserved by', 'planner')|json_encode|raw }},
                col_state: {{ __('Status', 'planner')|json_encode|raw }}
            }
        });
    });
</script>
